---
// apps/site/src/pages/seeds/[slug].astro
import Base from '../../layouts/Base.astro';
import { getSeeds } from '../../lib/verdecito';

export async function getStaticPaths() {
  const seeds = await getSeeds();
  return seeds.map(seed => ({
    params: { slug: seed.slug },
    props:  { seed },
  }));
}

const { seed } = Astro.props;
const isTeaser = seed.visibility === 'teaser';
---

<Base title={seed.title} description={seed.summary?.trim()}>
  <div style="margin-top:2rem">
    <p style="margin-bottom:0.75rem">
      <a href="/seeds">← Seeds</a>
    </p>

    <div class="object-header">
      <div class="type-label">Seed</div>
      <h1>
        {seed.title}
        {isTeaser && <span class="badge badge-teaser">teaser</span>}
      </h1>
      {seed.summary && <p class="summary">{seed.summary.trim()}</p>}
    </div>

    {/* Public: render full body */}
    {!isTeaser && seed.bodyHtml && (
      <div class="object-body" set:html={seed.bodyHtml} />
    )}

    {/* Public with no body yet */}
    {!isTeaser && !seed.bodyHtml && (
      <p style="color:var(--muted);font-style:italic">Body content coming soon.</p>
    )}

    {/* Teaser: only title + summary shown above; body withheld */}
    {isTeaser && (
      <div class="teaser-notice">
        <strong>Teaser.</strong> Full content is not yet public. Follow
        <a href="https://github.com/verdecito-life" target="_blank" rel="noopener">Verdecito on GitHub</a>
        or <a href="/support">support the project</a> to stay informed.
      </div>
    )}

    {/* Metadata */}
    <hr style="margin-top:2.5rem" />
    <dl style="font-size:0.85rem;color:var(--muted);display:grid;grid-template-columns:auto 1fr;gap:0.3rem 1rem">
      <dt style="font-weight:600">ID</dt>       <dd>{seed.id}</dd>
      <dt style="font-weight:600">Lifecycle</dt><dd>{seed.lifecycle}</dd>
      <dt style="font-weight:600">Schema</dt>   <dd>{seed.schema_version}</dd>
      {seed.created && <><dt style="font-weight:600">Created</dt><dd>{seed.created as string}</dd></>}
      {seed.updated && <><dt style="font-weight:600">Updated</dt><dd>{seed.updated as string}</dd></>}
    </dl>
  </div>
</Base>
