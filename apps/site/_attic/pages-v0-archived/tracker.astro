---
// apps/site/src/pages/tracker.astro
import Base from '../layouts/Base.astro';
import { getTracker, getIdentity, getSeeds, getQuests } from '../lib/verdecito';

const tracker  = getTracker();
const identity = getIdentity();
const seeds    = await getSeeds();
const quests   = await getQuests();

const publicSeeds  = seeds.filter(s  => s.visibility === 'public');
const teaserSeeds  = seeds.filter(s  => s.visibility === 'teaser');
const publicQuests = quests.filter(q => q.visibility === 'public');
const teaserQuests = quests.filter(q => q.visibility === 'teaser');
---

<Base
  title="Tracker"
  description="Live view of the Verdecito public reference tracker — active seeds and quests."
>
  <div class="page-hero" style="margin-top:2rem">
    <div class="eyebrow">Tracker</div>
    <h1>{tracker.title as string}</h1>
    <p>{tracker.description as string}</p>
  </div>

  <section class="tracker-section">
    <h2>Tracker metadata</h2>
    <ul class="meta-list">
      <li><span class="key">ID</span><span>{tracker.id as string}</span></li>
      <li><span class="key">Identity</span><span>{identity.title as string}</span></li>
      <li><span class="key">Skin</span><span>{tracker.declared_skin as string}</span></li>
      <li><span class="key">Schema</span><span>{tracker.schema_version as string}</span></li>
      <li><span class="key">Stability</span><span>{tracker.stability as string}</span></li>
    </ul>
  </section>

  <section class="tracker-section">
    <h2>Seeds ({seeds.length} active)</h2>
    <div class="card-grid">
      {seeds.map(seed => (
        <a href={`/seeds/${seed.slug}`} class="card">
          <div class="card-title">
            {seed.title}
            {seed.visibility === 'teaser' && <span class="badge badge-teaser">teaser</span>}
          </div>
          {seed.summary && <p class="card-summary">{seed.summary.trim()}</p>}
        </a>
      ))}
    </div>
    <p style="font-size:0.8rem;color:var(--muted);margin-top:0.75rem">
      {publicSeeds.length} public · {teaserSeeds.length} teaser · private excluded by render policy
    </p>
  </section>

  <section class="tracker-section">
    <h2>Quests ({quests.length} active)</h2>
    <div class="card-grid">
      {quests.map(quest => (
        <a href={`/quests/${quest.slug}`} class="card">
          <div class="card-title">
            {quest.title}
            {quest.visibility === 'teaser' && <span class="badge badge-teaser">teaser</span>}
          </div>
          {quest.summary && <p class="card-summary">{quest.summary.trim()}</p>}
        </a>
      ))}
    </div>
    <p style="font-size:0.8rem;color:var(--muted);margin-top:0.75rem">
      {publicQuests.length} public · {teaserQuests.length} teaser · private excluded by render policy
    </p>
  </section>
</Base>
