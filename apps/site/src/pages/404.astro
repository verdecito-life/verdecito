---
// apps/site/src/pages/404.astro
// Custom 404 — uses the site shell so the header/footer/frame stay consistent.
import Base from '../layouts/Base.astro';
import CtaGroup from '../components/CtaGroup.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${BASE}${p}`;
---
<Base
  lang="en"
  title="Page not found"
  description="This page could not be found."
  enPath="/"
>
  <section class="section hero">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1 class="hero-title">This path hasn’t sprouted.</h1>
      <p class="hero-body">The page you were looking for isn’t here. It may have moved, or never existed.</p>
      <CtaGroup
        ctas={[
          { label: 'Back to home', href: u('/'), variant: 'primary' },
          { label: 'Living Memory', href: u('/quests/Q001'), variant: 'secondary' },
        ]}
      />
    </div>
  </section>
</Base>
<!-- apps/site/src/pages/404.astro -->
