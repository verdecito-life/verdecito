---
// apps/site/src/pages/about.astro
// Why Verdecito — not in top nav; reachable from hero micro-link and footer.
import Base from '../layouts/Base.astro';
import { getIdentity } from '../lib/verdecito';

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
function u(path: string): string { return `${BASE}${path}`; }

const identity = getIdentity();
const values   = (identity.values as string[]) ?? [];
// TODO: read mottos / differentiators / one-liners from canonical objects when they exist.
---

<Base
  title="About"
  description="Why Verdecito — name, values, lineage, and forkable identity."
>
  <article style="margin-top:2rem">
    <div class="eyebrow">About</div>
    <h1>Why Verdecito</h1>

    <section style="margin-top:1.5rem">
      <h2>The name</h2>
      <p style="font-style:italic">"Verdecito" means something small and green enough to begin.</p>
      <p>
        It is not a brand everyone has to adopt. It is the name of this reference
        instance, this skin, this flavor, this commitment: work that cares for life,
        grows in public where appropriate, and stays honest about what is private,
        unfinished, risky, or borrowed from others.
      </p>
      <p style="font-weight:500;margin-top:1rem">
        You do not need to like the word Verdecito to use the method.
      </p>
    </section>

    <section style="margin-top:2.5rem">
      <h2>Identity</h2>
      <p>
        Every AI system, project tracker, funding process, and knowledge garden has
        hidden values. Verdecito makes its values visible so they can be inspected,
        challenged, forked, or replaced.
      </p>
      {values.length > 0 && (
        <ul class="values-list">
          {values.map((v: string) => <li>{v}</li>)}
        </ul>
      )}
    </section>

    <section style="margin-top:2.5rem">
      <h2>Forkable identity</h2>
      <p>
        The method can be reused with other values, vocabularies, skins, communities,
        and private modules or tools. You do not need to adopt everything.
      </p>
      <ul>
        <li>A serious SDG financing tracker should not sound like a cultural garden.</li>
        <li>An animal welfare instance may need different filters, risks, evidence, and support paths.</li>
        <li>A private team may keep all content closed while still using the same seed → quest → sprout logic.</li>
        <li>
          A commercial fork may adapt the method into a paid product because the
          {' '}<a href="https://github.com/verdecito-life/verdecito/blob/main/LICENSE"
               target="_blank" rel="noopener">license</a> allows it.
        </li>
      </ul>
      <p style="font-style:italic;color:var(--muted);margin-top:1rem">
        The point is not to force Verdecito's identity everywhere. The point is to make
        identity explicit enough that any instance can know what it is optimizing for.
      </p>
      {/* TODO: image set — same engine / different skins. Prompts ready in skeleton. */}
    </section>

    <section style="margin-top:2.5rem">
      <h2>Where this comes from</h2>
      <p>Verdecito is made in Mallasa, La Paz, Bolivia. Shaped by place, community, and the work of making ideas useful in real life.</p>
      <p style="font-size:.9rem;color:var(--muted)">
        This is the starting / founding team, not the boundary of the project.
      </p>
      {/* TODO: team photo + bios — decision pending: here or on /support.
                Image verdecito_team_founders.png is already_final_external;
                surrounding copy must not duplicate image text. */}
    </section>

    <section style="margin-top:2.5rem">
      <h2>What's next</h2>
      <p>
        The first concrete quest is <a href={u('/quests/Q001')}>Living Memory</a>.
        If the method works there, more quests follow. Either way, the work stays open.
      </p>
      <p style="margin-top:1.25rem">
        <a href={u('/method')}  class="btn btn-primary">How the method works</a>
        {' '}
        <a href={u('/support')} class="btn btn-secondary">Support Verdecito</a>
      </p>
    </section>
  </article>
</Base>

<style>
  .eyebrow { font-size:.75rem; letter-spacing:.1em; text-transform:uppercase; color:var(--muted); margin-bottom:.4rem; }
  .values-list { margin-top:.75rem; list-style:"🌿  "; padding-left:1.25rem; }
  .values-list li { padding:.2rem 0; }
  .btn-primary   { background:var(--green-800); color:white; }
  .btn-secondary { background:transparent; color:var(--green-800); border:1px solid var(--green-800); }
</style>
<!-- apps/site/src/pages/about.astro / Why Verdecito / not in top nav -->
