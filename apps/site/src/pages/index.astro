---
// apps/site/src/pages/index.astro
import Base from '../layouts/Base.astro';
import { getQuests } from '../lib/verdecito';

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
function u(path: string): string { return `${BASE}${path}`; }

const quests  = await getQuests();
const q001    = quests.find(q => q.id === 'quest:verdecito:001');
const q001Title = q001?.title ?? 'Conversations into Living Memory';
// TODO: when `featured_home_content` / `feature_blocks` exists on quests,
//       the Current Quest card should read from that field, not from here.
---

<Base
  title="Verdecito"
  description="For work that wants to stay alive. Open method. Private content. Lineage respected."
>
  {/* ── Hero ──────────────────────────────────────────────────────────────── */}
  <section class="hero" style="margin-top:2.5rem">
    <h1 class="hero-title">For work that wants to stay alive.</h1>
    <p class="hero-subtitle">Open method. Private content. Lineage respected.</p>

    <p class="hero-body">
      Verdecito is a forkable space where conversations, ideas, artifacts, and pilots
      leave reusable traces — not noise.
    </p>

    <p class="hero-trust">Method public. Content yours. Lineage respected.</p>

    <div class="hero-ctas">
      <a href={u('/quests/Q001')} class="btn btn-primary">See Living Memory</a>
      <a href={u('/method')}      class="btn btn-secondary">How the method works</a>
    </div>

    <p class="hero-microlink">
      <a href={u('/about')}>Why "Verdecito"?</a>
    </p>

    {/* TODO: image slot — verdecito_home_hero_open_method_private_content_lineage.png (prompt_ready) */}
  </section>

  <hr style="margin:3rem 0 2rem" />

  {/* ── Current Quest ────────────────────────────────────────────────────── */}
  <section class="current-quest">
    <div class="eyebrow">Now growing: Living Memory</div>
    <h2>Q001 — {q001Title}</h2>

    {/* TODO: image slot — verdecito_living_memory_conversation_to_traces.png (prompt_ready) */}

    <p>
      A forkable method for turning meaningful conversations into durable memory,
      decisions, and reusable traces — without reducing ideas to tasks and without
      making private content public.
    </p>
    <p>
      A working version already exists. The quest is to publish it, compare it
      honestly with what came before, and invite feedback that will shape what
      comes next.
    </p>

    {/* TODO: move status line into canonical quest fields: financing_status,
              lineage_status, lifecycle, expected_sprouts. */}
    <p class="status-line">
      Active · Recovery Kit v1.0.0 target after Q001 · Lineage scan in progress
    </p>

    <div class="hero-ctas">
      <a href={u('/quests/Q001')}         class="btn btn-primary">Open Living Memory</a>
      <a href={u('/quests/Q001') + '#sample'} class="btn btn-secondary">See a sample recovery</a>
    </div>
  </section>

  <hr style="margin:3rem 0 2rem" />

  {/* ── Method teaser ───────────────────────────────────────────────────── */}
  <section class="method-teaser">
    <h2>The method, in three lines</h2>
    <ul class="three-bullets">
      <li><strong>Seeds</strong> hold living possibilities — public, private, or in between.</li>
      <li><strong>Quests</strong> move selected seeds through real work, lineage, risk, and evidence.</li>
      <li><strong>Sprouts</strong> are the usable outputs — templates, prompts, repos, methods, examples, poems, pages, and reports.</li>
    </ul>
    <p><a href={u('/method')}>How the method works →</a></p>
  </section>

  <hr style="margin:3rem 0 2rem" />

  {/* ── Lineage strip ───────────────────────────────────────────────────── */}
  <section class="lineage-strip">
    <h2>Standing on older trenzas</h2>
    <p>
      Verdecito does not invent its parts. It composes them: regenerative economics,
      Buen Vivir, OSS commons, digital gardens, civic deliberation, regenerative
      communities, and public-interest AI.
    </p>
    <p><a href={u('/method') + '#lineage'}>See the lineage →</a></p>
    {/* TODO: canonical lineage object → render from it and link individual lineages to sources */}
  </section>

  <hr style="margin:3rem 0 2rem" />

  {/* ── Support teaser ──────────────────────────────────────────────────── */}
  <section class="support-teaser">
    <h2>Support</h2>
    <p>
      Verdecito will be published as open-source work either way. Support changes the
      pace, depth, and care available for the work — not the outcome.
    </p>
    <p><a href={u('/support')} class="btn btn-primary">Support Verdecito</a></p>
  </section>
</Base>

<style>
  .hero-title    { font-size:2.25rem; line-height:1.15; margin-bottom:.5rem; }
  .hero-subtitle { font-size:1.15rem; color:var(--green-700); font-weight:500; margin-bottom:1rem; }
  .hero-body     { font-size:1.05rem; margin-bottom:1rem; }
  .hero-trust    { font-size:.95rem; color:var(--muted); font-style:italic; margin-bottom:1.5rem; }
  .hero-ctas     { display:flex; gap:.75rem; flex-wrap:wrap; margin-bottom:1rem; }
  .hero-microlink { margin-top:.5rem; font-size:.9rem; }
  .eyebrow { font-size:.75rem; letter-spacing:.1em; text-transform:uppercase; color:var(--muted); margin-bottom:.4rem; }
  .status-line { font-size:.85rem; color:var(--muted); margin-top:.5rem; margin-bottom:1.25rem; }
  .three-bullets { list-style:none; padding:0; }
  .three-bullets li { padding:.4rem 0; border-bottom:1px solid var(--border); }
  .three-bullets li:last-child { border-bottom:none; }
  .btn-primary   { background:var(--green-800); color:white; }
  .btn-secondary { background:transparent; color:var(--green-800); border:1px solid var(--green-800); }
</style>
<!-- apps/site/src/pages/index.astro / Home v0.1 -->
