---
// apps/site/src/pages/how-it-works.astro
// Legacy path → harmless redirect to /method. No rendered content.
// Kept only so old inbound links don't break. Not in the public nav.
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const target = `${BASE}/method`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
    <title>Redirecting…</title>
  </head>
  <body>
    <a href={target}>Continue to Method</a>
  </body>
</html>
<!-- apps/site/src/pages/how-it-works.astro -->
