---
// apps/site/src/pages/es/quests/Q001/prompt.astro — Prompt de Memoria Viva (ES), rendered at build time.
import Base from '../../../../layouts/Base.astro';
import RenderedArtifact from '../../../../components/RenderedArtifact.astro';
import { Content } from '../../../../artifacts/RecoverThisChat_LivingMemoryPrompt.md';
import { href } from '../../../../lib/lang';
import { living } from '../../../../copy/common';

const lang = 'es' as const;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${BASE}${p}`;
---
<Base
  lang={lang}
  title="El Prompt de Memoria Viva"
  description="Lee el Prompt de Memoria Viva: dáselo a un asistente de IA, escribe «Recupera este chat» y convierte una conversación importante en memoria Markdown reutilizable."
  enPath={living.promptPage}
>
  <RenderedArtifact
    Content={Content}
    heading="El Prompt de Memoria Viva"
    intro="Léelo aquí primero. Dáselo a un asistente de IA, escribe «Recupera este chat» y convierte una conversación importante en memoria Markdown reutilizable que puedes corregir, proteger y continuar. (El prompt es canónico en inglés.)"
    downloadHref={u(living.promptDownload)}
    downloadLabel="Descargar prompt MD"
    downloadName="RecoverThisChat_LivingMemoryPrompt.md"
    backHref={href(BASE, lang, '/quests/Q001')}
    backLabel="Volver a Memoria Viva"
  />
</Base>
