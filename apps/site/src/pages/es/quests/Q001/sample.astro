---
// apps/site/src/pages/es/quests/Q001/sample.astro — Muestra pública anonimizada (ES), rendered at build time.
import Base from '../../../../layouts/Base.astro';
import RenderedArtifact from '../../../../components/RenderedArtifact.astro';
import { Content } from '../../../../artifacts/Ecotourism_Pilot_Recovery_Redacted.md';
import { href } from '../../../../lib/lang';
import { living } from '../../../../copy/common';

const lang = 'es' as const;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${BASE}${p}`;
---
<Base
  lang={lang}
  title="Muestra pública de recuperación"
  description="Una recuperación real, anonimizada para verse en público, hecha con el Prompt de Memoria Viva: decisiones, correcciones, registro de ideas y un punto de continuación, con redacciones visibles."
  enPath={living.samplePage}
>
  <RenderedArtifact
    Content={Content}
    heading="Muestra pública de recuperación"
    intro="Una recuperación real, anonimizada para verse en público. Los nombres de terceros y el contexto privado se enmascaran con marcadores visibles, para que veas exactamente qué preserva una recuperación antes de confiar en el método."
    downloadHref={u(living.sampleDownload)}
    downloadLabel="Descargar muestra MD"
    downloadName="Ecotourism_Pilot_Recovery_Redacted.md"
    backHref={href(BASE, lang, '/quests/Q001')}
    backLabel="Volver a Memoria Viva"
  />
</Base>
