---
// apps/site/src/pages/quests/[slug].astro
import Base from '../../layouts/Base.astro';
import { getQuests } from '../../lib/verdecito';

export async function getStaticPaths() {
  const quests = await getQuests();
  return quests.map(quest => ({
    params: { slug: quest.slug },
    props:  { quest },
  }));
}

const { quest } = Astro.props;
const isTeaser = quest.visibility === 'teaser';
---

<Base title={quest.title} description={quest.summary?.trim()}>
  <div style="margin-top:2rem">
    <p style="margin-bottom:0.75rem">
      <a href="/quests">← Quests</a>
    </p>

    <div class="object-header">
      <div class="type-label">Quest</div>
      <h1>
        {quest.title}
        {isTeaser && <span class="badge badge-teaser">teaser</span>}
      </h1>
      {quest.summary && <p class="summary">{quest.summary.trim()}</p>}
    </div>

    {/* Public: render full body */}
    {!isTeaser && quest.bodyHtml && (
      <div class="object-body" set:html={quest.bodyHtml} />
    )}

    {/* Public with no body yet */}
    {!isTeaser && !quest.bodyHtml && (
      <p style="color:var(--muted);font-style:italic">Body content coming soon.</p>
    )}

    {/* Teaser: body withheld */}
    {isTeaser && (
      <div class="teaser-notice">
        <strong>Teaser.</strong> Full content is not yet public. Follow
        <a href="https://github.com/verdecito-life" target="_blank" rel="noopener">Verdecito on GitHub</a>
        or <a href="/support">support the project</a> to stay informed.
      </div>
    )}

    {/* Metadata */}
    <hr style="margin-top:2.5rem" />
    <dl style="font-size:0.85rem;color:var(--muted);display:grid;grid-template-columns:auto 1fr;gap:0.3rem 1rem">
      <dt style="font-weight:600">ID</dt>       <dd>{quest.id}</dd>
      <dt style="font-weight:600">Lifecycle</dt><dd>{quest.lifecycle}</dd>
      <dt style="font-weight:600">Schema</dt>   <dd>{quest.schema_version}</dd>
      {quest.created && <><dt style="font-weight:600">Created</dt><dd>{quest.created as string}</dd></>}
      {quest.updated && <><dt style="font-weight:600">Updated</dt><dd>{quest.updated as string}</dd></>}
    </dl>
  </div>
</Base>
