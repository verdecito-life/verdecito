---
// apps/site/src/pages/quests/Q001.astro
// Static route — takes precedence over [slug].astro for the public /quests/Q001 URL.
// Resolves Q001 canonical object by id, not by filename slug.
import Base from '../../layouts/Base.astro';
import { getQuests } from '../../lib/verdecito';

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
function u(path: string): string { return `${BASE}${path}`; }

const quests = await getQuests();
const quest  = quests.find(q => q.id === 'quest:verdecito:001');

if (!quest) {
  throw new Error(
    '[verdecito] BUILD FAIL — Q001 not found. Expected quest with id "quest:verdecito:001".',
  );
}

const title    = quest.title as string;
const summary  = (quest.summary as string | undefined)?.trim() ?? '';
const bodyHtml = quest.bodyHtml;

const ISSUES_URL = 'https://github.com/verdecito-life/verdecito/issues';
---

<Base
  title={`Q001 — ${title}`}
  description={summary || 'Conversations into Living Memory — the first public Verdecito quest.'}
>
  <article style="margin-top:2rem">
    <div class="eyebrow">Quest · Q001</div>
    <h1>{title}</h1>
    {summary && <p class="lead">{summary}</p>}

    {/* TODO: image slot — verdecito_living_memory_conversation_to_traces.png (prompt_ready) */}

    <section style="margin-top:2rem">
      <h2>The question</h2>
      <p>
        How can important conversations become durable memory, seeds, quests,
        sprouts, or better decisions — without becoming another black-box AI
        memory product?
      </p>
    </section>

    {bodyHtml && (
      <section class="object-body" style="margin-top:2rem" set:html={bodyHtml} />
    )}

    <section style="margin-top:2rem">
      <h2>Current status</h2>
      <p>Active · public · lineage scan in progress.</p>
      {/* TODO: derive from canonical fields: lifecycle, visibility, lineage_status, peaje_status. */}
    </section>

    <section style="margin-top:2rem">
      <h2>Expected output</h2>
      <p>
        Recovery Kit v0.1: a forkable method, sample output, privacy statement,
        lineage note, and usage instructions.
      </p>
      <p style="font-size:.85rem;color:var(--muted)">
        Recovery Kit / SPEC v1.0.0 is separate from Verdecito site/repo versioning
        and from the internal ER Conversation Recovery SPEC v0.3.2.
      </p>
      {/* TODO: add `expected_sprouts` field to quest schema and read from it. */}
    </section>

    <section style="margin-top:2rem">
      <h2>What exists already</h2>
      <p>A working home-version, used in real conversations and recoveries.</p>
    </section>

    <section style="margin-top:2rem">
      <h2>What this quest will do</h2>
      <ul>
        <li>Compare the method with existing tools and traditions.</li>
        <li>Credit and link what came before.</li>
        <li>Ship a stable public Recovery Kit / SPEC v1.0.0 if the kit is solid enough.</li>
        <li>Show a real sample recovery.</li>
        <li>Explain privacy and consent clearly.</li>
        <li>Invite feedback that shapes current and future versions.</li>
      </ul>
    </section>

    <section style="margin-top:2rem">
      <h2>What this quest is not</h2>
      <ul>
        <li>Not a second brain.</li>
        <li>Not a meeting summarizer.</li>
        <li>Not a PKM replacement.</li>
        <li>Not an AI memory database.</li>
        <li>Not a claim that Verdecito invented living memory.</li>
      </ul>
    </section>

    <section id="sample" style="margin-top:2rem">
      <h2>Sample recovery</h2>
      <p style="color:var(--muted);font-style:italic">
        A sample recovery output will be linked here once a public sample artifact
        is selected and added to the repo.
      </p>
      {/* TODO: link here once instances/verdecito/artifacts/ has a public sample. */}
    </section>

    <section style="margin-top:2rem">
      <h2>Support needed</h2>
      <p>
        Feedback, lineage suggestions, testers, OSS critique, sponsor support for
        time and tooling, and early conversations with people who want to
        understand or help shape the quest.
      </p>
      <p>
        <a href={u('/support')} class="btn btn-primary">Ways to support</a>
        {' '}
        <a href="mailto:verdecito@barranco.life?subject=Living%20Memory%20feedback"
           class="btn btn-secondary">Send Living Memory feedback</a>
      </p>
      {/* TODO: when `issue_template_url` exists on the quest, add a direct GitHub issue CTA. */}
    </section>

    <section style="margin-top:2rem">
      <h2>Contact</h2>
      <p>
        Primary contact: <a href="mailto:verdecito@barranco.life">verdecito@barranco.life</a>
        · <a href={ISSUES_URL} target="_blank" rel="noopener">GitHub Issues</a>
      </p>
      <p style="font-size:.9rem">
        Prefilled subjects:
        {' '}<a href="mailto:verdecito@barranco.life?subject=Living%20Memory%20feedback">Living Memory feedback</a> ·
        {' '}<a href="mailto:verdecito@barranco.life?subject=Seed%20submission">Seed submission</a> ·
        {' '}<a href="mailto:verdecito@barranco.life?subject=Sponsor%20conversation">Sponsor conversation</a> ·
        {' '}<a href="mailto:verdecito@barranco.life?subject=Conversation%20request">Conversation request</a>
      </p>
    </section>

    <hr style="margin-top:3rem" />
    <dl style="font-size:.8rem;color:var(--muted);display:grid;grid-template-columns:auto 1fr;gap:.3rem 1rem">
      <dt style="font-weight:600">ID</dt>         <dd>{quest.id}</dd>
      <dt style="font-weight:600">Lifecycle</dt>  <dd>{quest.lifecycle}</dd>
      <dt style="font-weight:600">Visibility</dt> <dd>{quest.visibility}</dd>
      <dt style="font-weight:600">Schema</dt>     <dd>{quest.schema_version}</dd>
    </dl>
  </article>
</Base>

<style>
  .lead   { font-size:1.1rem; color:var(--muted); margin-top:.5rem; }
  .eyebrow { font-size:.75rem; letter-spacing:.1em; text-transform:uppercase; color:var(--muted); margin-bottom:.4rem; }
  .btn-primary   { background:var(--green-800); color:white; }
  .btn-secondary { background:transparent; color:var(--green-800); border:1px solid var(--green-800); }
</style>
<!-- apps/site/src/pages/quests/Q001.astro / Living Memory public page -->
