---
// apps/site/src/pages/support.astro
import Base from '../layouts/Base.astro';
import { getSupportInfo } from '../lib/verdecito';

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
function u(path: string): string { return `${BASE}${path}`; }

const { ask, channel } = getSupportInfo();
const sponsorsUrl = channel.url as string;
const REPO_URL   = 'https://github.com/verdecito-life/verdecito';
const ISSUES_URL = 'https://github.com/verdecito-life/verdecito/issues';
// TODO: when `issue_template_url` exists on the ask object, use it for seed intake CTA.
---

<Base
  title="Support"
  description="Many ways to support Verdecito: attention, sharing, using, forking, sponsoring, seeds."
>
  <article style="margin-top:2rem">
    <div class="eyebrow">Support</div>
    <h1>Support Verdecito</h1>
    <p class="lead">
      Verdecito is open spec, open instance, and open invitation. Supporting it means
      supporting time: time to refine the method, test the first sprouts, keep the
      public surface honest, and make the tools useful for others.
    </p>
    <p style="margin-top:1rem">
      A practical part of Verdecito's success is whether its founding work can become
      financially sustainable without closing what should stay open.
    </p>

    {/* TODO: image slot — verdecito_support_working_surface.png (prompt_ready) */}

    <section style="margin-top:2.5rem">
      <h2>1. Support with attention</h2>
      <p>
        The simplest support is attention with care: read, question, critique, and tell
        us where the method is unclear, naive, risky, or useful.
      </p>
      <p>
        <a href={ISSUES_URL} target="_blank" rel="noopener" class="btn btn-secondary">Open an issue on GitHub</a>
        {' '}
        <a href="mailto:verdecito@barranco.life?subject=Feedback%20on%20Verdecito" class="btn btn-secondary">Send feedback</a>
      </p>
    </section>

    <section style="margin-top:2.5rem">
      <h2>2. Support by sharing</h2>
      <p>
        Share Verdecito with someone who may understand, question, use, fund, fork, or
        improve it.
      </p>
      {/* TODO: OG image + social preview metadata once verdecito_home_hero asset exists. */}
    </section>

    <section style="margin-top:2.5rem">
      <h2>3. Support by using</h2>
      <p>
        See a sample Recovery Sprout first. If it resonates, try it on one meaningful
        conversation. If it helps, that is a signal. If it fails, that is also useful.
      </p>
      <a href={u('/quests/Q001') + '#sample'} class="btn btn-primary">See a sample recovery</a>
    </section>

    <section style="margin-top:2.5rem">
      <h2>4. Support by forking</h2>
      <p>
        Fork the repo. Rename it. Replace the values. Run your own instance. A fork is
        the strongest signal that the method works beyond Verdecito.
      </p>
      <a href={REPO_URL} target="_blank" rel="noopener" class="btn btn-primary">Fork on GitHub</a>
    </section>

    <section style="margin-top:2.5rem">
      <h2>5. Support by sponsoring</h2>
      <p>Financial support sustains core work: spec, reference instance, recovery method, documentation, and AI/tooling time.</p>
      <p>What sponsorship materially unlocks:</p>
      <ul>
        <li>Deeper lineage scans before claiming originality.</li>
        <li>A second contributor on critical work.</li>
        <li>Better tooling for people testing Verdecito on their own work.</li>
        <li>More frequent, honest public outputs.</li>
      </ul>
      <p style="font-size:.9rem;color:var(--muted)">
        Primary channel: GitHub Sponsors. Tiers exist as an onramp, not as the headline.
        Current tiers may be fine-tuned after the v0.1 learning pass.
      </p>
      <div style="margin-top:1.25rem">
        <p style="margin-bottom:.75rem">{(channel.summary as string).trim()}</p>
        <a href={sponsorsUrl} target="_blank" rel="noopener" class="btn btn-primary">Sponsor on GitHub →</a>
        {' '}
        <a href="mailto:verdecito@barranco.life?subject=Sponsor%20conversation" class="btn btn-secondary">Talk first</a>
      </div>
      <p style="font-size:.9rem;color:var(--muted);margin-top:1rem">
        Founder sustainability note: the pace of Verdecito depends on whether Ernesto
        can dedicate real working time to it and make a living from green/open work
        without enclosing the method.
      </p>
    </section>

    <section style="margin-top:2.5rem">
      <h2>6. Submit a seed</h2>
      <p>
        Have a life-aligned idea, project, place, tool, or question that needs
        structure? Send it as a rough seed. It does not need to be polished.
      </p>
      <p>
        <a href={ISSUES_URL} target="_blank" rel="noopener" class="btn btn-primary">Open a seed issue</a>
        {' '}
        <a href="mailto:verdecito@barranco.life?subject=Seed%20submission" class="btn btn-secondary">Send by email</a>
      </p>
      {/* TODO: once GitHub issue template for seeds exists, point to ?template=seed.md */}
    </section>

    <section style="margin-top:2.5rem">
      <h2>The starting team</h2>
      <p>Verdecito is made in Mallasa, La Paz, Bolivia. Shaped by place, community, and the work of making ideas useful in real life.</p>
      {/* TODO: team photo decision — here or on /about. Image verdecito_team_founders.png
                is already_final_external; copy must not duplicate image text. */}
    </section>
  </article>
</Base>

<style>
  .lead { font-size:1.1rem; color:var(--muted); margin-top:.5rem; }
  .eyebrow { font-size:.75rem; letter-spacing:.1em; text-transform:uppercase; color:var(--muted); margin-bottom:.4rem; }
  .btn-primary   { background:var(--green-800); color:white; }
  .btn-secondary { background:transparent; color:var(--green-800); border:1px solid var(--green-800); }
</style>
<!-- apps/site/src/pages/support.astro / Support v0.1 -->
