---
// apps/site/src/layouts/Base.astro
// Shared shell for all Verdecito v0.1 public pages (EN + ES).
//
// Each page passes:
//   lang        'en' | 'es'
//   title       short page title (home passes 'Verdecito' and is used as-is)
//   description meta description for this page + language
//   enPath      the EN canonical path of this page ('/', '/method', …) —
//               used to build the language switch + hreflang pair
//   ogImage     optional path to the page's OG card (e.g. '/og/home.jpg')
//
// Pages render full-width <section> blocks that carry their own .container,
// so the shell does NOT wrap the slot in a container.

import type { Lang } from '../lib/lang';
import { htmlLang, localizePath } from '../lib/lang';
import { nav, wordmark, footerLinks, closingLine } from '../copy/common';
import LanguageSwitch from '../components/LanguageSwitch.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  enPath: string;
  ogImage?: string;
}
const { lang, title, description, enPath, ogImage } = Astro.props;

const fullTitle = title === wordmark ? wordmark : `${title} — ${wordmark}`;

// BASE is '/verdecito' in production, '' locally (BASE_URL trailing slash removed).
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (path: string): string => `${BASE}${path}`;

// Language pair for this page.
const enHref = u(localizePath('en', enPath));
const esHref = u(localizePath('es', enPath));
const selfHref = u(localizePath(lang, enPath));

// Absolute URLs (production has Astro.site via SITE_URL; locally it may be undefined).
const site = Astro.site;
const abs = (p: string): string => (site ? new URL(p, site).href : p);

const ogImageAbs = ogImage ? abs(u(ogImage)) : undefined;

// Theme switch: fixed name per language; aria-pressed carries the state.
const themeLabel = lang === 'es' ? 'Modo oscuro' : 'Dark mode';

const homeHref = u(localizePath(lang, '/'));
const currentPath = Astro.url.pathname;
const navItems = nav.map((item) => {
  const href = u(localizePath(lang, item.path));
  const current = item.path === '/'
    ? currentPath === href || currentPath === `${href}/` || currentPath === homeHref
    : currentPath === href || currentPath.startsWith(`${href}/`);
  return { href, label: item.label[lang], current };
});

const footer = footerLinks.map((link) => {
  if (link.external) return { label: link.label[lang], href: link.href, external: true };
  const href = u(localizePath(lang, link.href)) + (link.hash ?? '');
  return { label: link.label[lang], href, external: false };
});
---
<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>

    <link rel="canonical" href={abs(selfHref)} />
    <link rel="alternate" hreflang="en" href={abs(enHref)} />
    <link rel="alternate" hreflang="es" href={abs(esHref)} />
    <link rel="alternate" hreflang="x-default" href={abs(enHref)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(selfHref)} />
    <meta property="og:site_name" content={wordmark} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />
    {ogImageAbs && <>
      <meta property="og:image" content={ogImageAbs} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={fullTitle} />
    </>}
    <meta name="twitter:card" content={ogImageAbs ? 'summary_large_image' : 'summary'} />
    {ogImageAbs && <meta name="twitter:image" content={ogImageAbs} />}

    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    <link rel="sitemap" href={u('/sitemap-index.xml')} />
    <meta name="theme-color" content="#153f2a" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c2216" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Before first paint: mark that JavaScript runs and apply the saved theme;
      // with nothing saved, the system setting decides. The key is namespaced
      // because every *.github.io project site shares one storage origin.
      document.documentElement.classList.add('js');
      try {
        const t = localStorage.getItem('verdecito:theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href={homeHref} class="wordmark">{wordmark}</a>
        <div class="nav-row">
          <nav class="site-nav" aria-label="Primary">
            {navItems.map(({ href, label, current }) => (
              <a href={href} aria-current={current ? 'page' : undefined}>{label}</a>
            ))}
          </nav>
          <LanguageSwitch lang={lang} enHref={enHref} esHref={esHref} />
          <button class="theme-toggle" type="button" aria-pressed="false" aria-label={themeLabel} title={themeLabel}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path class="sun" d="M12 4V2m0 20v-2m8-8h2M2 12h2m13.66-5.66 1.41-1.41M4.93 19.07l1.41-1.41m0-11.32L4.93 4.93m14.14 14.14-1.41-1.41M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z" />
              <path class="moon" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <nav class="footer-links" aria-label="Footer">
          {footer.map(({ href, label, external }) => (
            <a
              href={href}
              {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >{label}</a>
          ))}
        </nav>
        <p class="footer-tagline">{closingLine[lang]}</p>
      </div>
    </footer>
    <script>
      // Theme switch: toggles and saves the choice; with no choice, follows the system.
      const KEY = 'verdecito:theme';
      const root = document.documentElement;
      const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
      const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : systemDark.matches);
      const sync = () => btn?.setAttribute('aria-pressed', String(isDark()));
      sync();
      systemDark.addEventListener('change', sync);
      btn?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem(KEY, next); } catch {}
        sync();
      });
      window.addEventListener('storage', (e) => {
        if (e.key !== KEY) return;
        if (e.newValue === 'light' || e.newValue === 'dark') root.dataset.theme = e.newValue;
        else delete root.dataset.theme;
        sync();
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/tokens.css';
  @import '../styles/global.css';
</style>
<!-- apps/site/src/layouts/Base.astro -->
