---
// apps/site/src/components/pages/About.astro
// About page body. Renders ONLY from the copy store. lang-agnostic.
// No hero image this pass (skeleton §9 — typography-led).
import type { Lang } from '../../lib/lang';
import { href, tl } from '../../lib/lang';
import { about, aboutRelBullets } from '../../copy/about';
import Hero from '../Hero.astro';
import CtaGroup from '../CtaGroup.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (p: string) => href(BASE, lang, p);
const T = (k: keyof typeof about) => about[k][lang];

const stance = [
  { t: T('s1Title'), b: T('s1Body') },
  { t: T('s2Title'), b: T('s2Body') },
  { t: T('s3Title'), b: T('s3Body') },
  { t: T('s4Title'), b: T('s4Body') },
];
---
<Hero
  eyebrow={T('heroEyebrow')}
  title={T('heroTitle')}
  subtitle={T('heroSubtitle')}
  body={T('heroBody')}
>
  <CtaGroup
    ctas={[
      { label: T('heroPrimary'),   href: link('/method'),      variant: 'primary' },
      { label: T('heroSecondary'), href: link('/quests/Q001'), variant: 'secondary' },
    ]}
  />
</Hero>

<!-- The name -->
<section class="section">
  <div class="container">
    <h2 class="section-title">{T('nameTitle')}</h2>
    <div class="prose stack-4">
      <p>{T('nameBody')}</p>
      <p>{T('nameFollowup')}</p>
    </div>
    <div class="callout" style="max-width: var(--measure); margin-top: var(--space-6);">
      <p class="callout-title" style="margin-bottom: 0;">{T('nameCallout')}</p>
    </div>
  </div>
</section>

<!-- The stance -->
<section class="section band-soft">
  <div class="container">
    <h2 class="section-title">{T('stanceTitle')}</h2>
    <p class="section-intro">{T('stanceIntro')}</p>
    <div class="card-grid cols-2">
      {stance.map((s) => (
        <div class="card">
          <h3 class="card-title">{s.t}</h3>
          <p class="card-body">{s.b}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Place and origin -->
<section class="section">
  <div class="container">
    <h2 class="section-title">{T('placeTitle')}</h2>
    <div class="prose stack-4">
      <p>{T('placeBody')}</p>
      <p>{T('placeFollowup')}</p>
    </div>
  </div>
</section>

<!-- Who is shaping this? (light steward section) -->
<section class="section band-soft">
  <div class="container">
    <h2 class="section-title">{T('stewardTitle')}</h2>
    <p class="prose" style="max-width: var(--measure);">{T('stewardBody')}</p>
  </div>
</section>

<!-- The name becomes a method -->
<section class="section">
  <div class="container">
    <h2 class="section-title">{T('relTitle')}</h2>
    <p class="prose">{T('relBody')}</p>
    <ul class="callout-list stack-4" style="margin-top: var(--space-5); max-width: var(--measure);">
      {tl(lang, aboutRelBullets).map((b) => <li>{b}</li>)}
    </ul>
  </div>
</section>

<!-- Current focus -->
<section class="section band-soft">
  <div class="container">
    <div class="closing prose">
      <h2 class="section-title">{T('focusTitle')}</h2>
      <p>{T('focusBody')}</p>
      <CtaGroup
        ctas={[
          { label: T('focusPrimary'),   href: link('/quests/Q001'), variant: 'primary' },
          { label: T('focusSecondary'), href: link('/method'),      variant: 'secondary' },
        ]}
      />
    </div>
  </div>
</section>
<!-- apps/site/src/components/pages/About.astro -->
