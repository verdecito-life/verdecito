---
// apps/site/src/components/pages/Support.astro
// Support page body. Renders ONLY from the copy store. lang-agnostic.
// Sponsors secondary CTA included (E2): label + link only, no tiers/prices/logistics.
import type { Lang } from '../../lib/lang';
import { href, tl } from '../../lib/lang';
import { images, site, mailto } from '../../copy/common';
import { support, supportChangesItems } from '../../copy/support';
import Hero from '../Hero.astro';
import CtaGroup from '../CtaGroup.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${BASE}${p}`;
const T = (k: keyof typeof support) => support[k][lang];

const ways = [
  { t: T('w1Title'), b: T('w1Body') },
  { t: T('w2Title'), b: T('w2Body') },
  { t: T('w3Title'), b: T('w3Body') },
  { t: T('w4Title'), b: T('w4Body') },
  { t: T('w5Title'), b: T('w5Body') },
  { t: T('w6Title'), b: T('w6Body') },
];
---
<Hero
  eyebrow={T('heroEyebrow')}
  title={T('heroTitle')}
  subtitle={T('heroSubtitle')}
  body={T('heroBody')}
  imageSrc={u(images.support.src)}
  imageAlt={images.support.alt[lang]}
  imageW={images.support.w}
  imageH={images.support.h}
>
  <CtaGroup
    ctas={[
      { label: T('heroPrimary'),   href: mailto('Support conversation — Verdecito'), variant: 'primary', external: true },
      { label: T('heroSecondary'), href: mailto('Verdecito feedback'),               variant: 'secondary', external: true },
    ]}
  />
</Hero>

<!-- Ways to support -->
<section class="section">
  <div class="container">
    <h2 class="section-title">{T('waysTitle')}</h2>
    <p class="section-intro">{T('waysIntro')}</p>
    <div class="card-grid cols-3">
      {ways.map((w) => (
        <div class="card">
          <h3 class="card-title">{w.t}</h3>
          <p class="card-body">{w.b}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Financial support -->
<section class="section band-soft">
  <div class="container">
    <h2 class="section-title">{T('finTitle')}</h2>
    <p class="section-intro">{T('finBody')}</p>
    <CtaGroup
      ctas={[
        { label: T('finPrimary'),  href: mailto('Support conversation — Verdecito'), variant: 'primary', external: true },
        { label: T('finSponsors'), href: site.sponsorsUrl, variant: 'secondary', external: true },
      ]}
    />
  </div>
</section>

<!-- What support changes -->
<section class="section">
  <div class="container">
    <h2 class="section-title">{T('changesTitle')}</h2>
    <ul class="callout-list stack-4" style="max-width: var(--measure);">
      {tl(lang, supportChangesItems).map((b) => <li>{b}</li>)}
    </ul>
  </div>
</section>

<!-- Boundaries / openness -->
<section class="section band-soft">
  <div class="container">
    <h2 class="section-title">{T('boundTitle')}</h2>
    <p class="prose">{T('boundBody')}</p>
    <p class="prose" style="margin-top: var(--space-5); font-family: var(--font-display); font-size: var(--text-lg);">{T('boundTrust')}</p>
  </div>
</section>

<!-- Contact -->
<section class="section">
  <div class="container">
    <div class="closing prose">
      <h2 class="section-title">{T('contactTitle')}</h2>
      <p>{T('contactBody')}</p>
      <CtaGroup
        ctas={[
          { label: T('contactPrimary'), href: mailto('Hello — Verdecito'), variant: 'primary', external: true },
          { label: T('contactRepo'),    href: site.repoUrl, variant: 'secondary', external: true },
        ]}
      />
    </div>
  </div>
</section>
<!-- apps/site/src/components/pages/Support.astro -->
