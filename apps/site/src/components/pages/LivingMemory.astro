---
// apps/site/src/components/pages/LivingMemory.astro
// Q001 page body. Prose comes ONLY from the copy store. The ONLY canonical data
// it shows is the allow-listed mapped metadata passed in via `meta` (id,
// lifecycle, visibility, schema_version) — never title/summary/body.
import type { Lang } from '../../lib/lang';
import { href, tl } from '../../lib/lang';
import type { QuestMeta } from '../../lib/verdecito';
import { images, mailto } from '../../copy/common';
import { lm, lmStatusRows, lmExistsBullets, lmPublishItems, lmNotItems } from '../../copy/livingMemory';
import Hero from '../Hero.astro';
import CtaGroup from '../CtaGroup.astro';

interface Props { lang: Lang; meta: QuestMeta; }
const { lang, meta } = Astro.props;

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${BASE}${p}`;
const link = (p: string) => href(BASE, lang, p);
const T = (k: keyof typeof lm) => lm[k][lang];

const sampleHref = u('/quests/Q001/sample-recovery.html');
const doesCards = [
  { t: T('doesC1Title'), b: T('doesC1Body') },
  { t: T('doesC2Title'), b: T('doesC2Body') },
  { t: T('doesC3Title'), b: T('doesC3Body') },
  { t: T('doesC4Title'), b: T('doesC4Body') },
  { t: T('doesC5Title'), b: T('doesC5Body') },
];
---
<Hero
  eyebrow={T('heroEyebrow')}
  title={T('heroTitle')}
  subtitle={T('heroSubtitle')}
  body={T('heroBody')}
  imageSrc={u(images.livingMemory.src)}
  imageAlt={images.livingMemory.alt[lang]}
  imageW={images.livingMemory.w}
  imageH={images.livingMemory.h}
>
  <CtaGroup
    ctas={[
      { label: T('heroPrimary'),   href: '#example', variant: 'primary' },
      { label: T('heroSecondary'), href: '#privacy', variant: 'secondary' },
    ]}
  />
</Hero>

<!-- Status / object metadata -->
<section class="section">
  <div class="container">
    <div class="meta-card" style="max-width: 640px;">
      <p class="meta-card-title">{T('metaTitle')}</p>
      <div class="meta-rows">
        {lmStatusRows.map((r) => (
          <div class="row"><span class="k">{r.k[lang]}</span><span class="v">{r.v[lang]}</span></div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- What it preserves -->
<section class="section band-soft">
  <div class="container">
    <h2 class="section-title">{T('doesTitle')}</h2>
    <p class="section-intro">{T('doesIntro')}</p>
    <div class="card-grid cols-3">
      {doesCards.map((c) => (
        <div class="card">
          <h3 class="card-title">{c.t}</h3>
          <p class="card-body">{c.b}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Already in use -->
<section class="section">
  <div class="container">
    <p class="eyebrow">{T('existsLabel')}</p>
    <h2 class="section-title">{T('existsTitle')}</h2>
    <div class="prose stack-4">
      <p>{T('existsBody')}</p>
    </div>
    <ul class="callout-list stack-4" style="margin-top: var(--space-5); max-width: var(--measure);">
      {tl(lang, lmExistsBullets).map((b) => <li>{b}</li>)}
    </ul>
  </div>
</section>

<!-- What Q001 is preparing -->
<section class="section">
  <div class="container">
    <h2 class="section-title">{T('publishTitle')}</h2>
    <p class="section-intro">{T('publishIntro')}</p>
    <ol class="prose stack-4" style="max-width: var(--measure);">
      {tl(lang, lmPublishItems).map((b) => <li>{b}</li>)}
    </ol>
  </div>
</section>

<!-- What this is not -->
<section class="section band-soft">
  <div class="container">
    <h2 class="section-title">{T('notTitle')}</h2>
    <ul class="clean-list" style="max-width: var(--measure);">
      {tl(lang, lmNotItems).map((b) => <li>{b}</li>)}
    </ul>
    <p class="closing" style="margin-top: var(--space-6); font-family: var(--font-display); font-size: var(--text-xl);">{T('notClosing')}</p>
  </div>
</section>

<!-- Privacy and lineage -->
<section id="privacy" class="section">
  <div class="container">
    <h2 class="section-title">{T('privTitle')}</h2>
    <div class="card-grid cols-2">
      <div class="card">
        <h3 class="card-title">{T('privCardTitle')}</h3>
        <p class="card-body">{T('privCardBody')}</p>
      </div>
      <div class="card">
        <h3 class="card-title">{T('linCardTitle')}</h3>
        <p class="card-body">{T('linCardBody')}</p>
      </div>
    </div>
  </div>
</section>

<!-- Inspectable example -->
<section id="example" class="section band-soft">
  <div class="container">
    <h2 class="section-title">{T('exTitle')}</h2>
    <p class="section-intro">{T('exBody')}</p>
    <CtaGroup ctas={[{ label: T('exFallback'), href: sampleHref, variant: 'secondary', external: true }]} />
  </div>
</section>

<!-- Feedback / support -->
<section class="section">
  <div class="container">
    <h2 class="section-title">{T('fbTitle')}</h2>
    <p class="section-intro">{T('fbBody')}</p>
    <CtaGroup
      ctas={[
        { label: T('fbPrimary'),   href: mailto('Q001 — Living Memory feedback'), variant: 'primary', external: true },
        { label: T('fbSecondary'), href: link('/support'), variant: 'secondary' },
      ]}
    />

    <!-- Mapped canonical metadata (allow-list only): id, lifecycle, visibility, schema_version -->
    <dl class="object-meta">
      <dt>Object</dt><dd>{meta.id}</dd>
      <dt>Lifecycle</dt><dd>{meta.lifecycle}</dd>
      <dt>Visibility</dt><dd>{meta.visibility}</dd>
      <dt>Schema</dt><dd>{meta.schema_version}</dd>
    </dl>
  </div>
</section>
<!-- apps/site/src/components/pages/LivingMemory.astro -->
