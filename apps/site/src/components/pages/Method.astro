---
// apps/site/src/components/pages/Method.astro
// Method page body. Renders ONLY from the copy store. lang-agnostic.
import type { Lang } from '../../lib/lang';
import { href } from '../../lib/lang';
import { images } from '../../copy/common';
import { method, methodVisibilityStates } from '../../copy/method';
import Hero from '../Hero.astro';
import CtaGroup from '../CtaGroup.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (p: string) => href(BASE, lang, p);
const T = (k: keyof typeof method) => method[k][lang];

const objects = [
  { t: T('seedsTitle'),   b: T('seedsBody'),   ex: T('seedsExample') },
  { t: T('questsTitle'),  b: T('questsBody'),  ex: T('questsExample') },
  { t: T('sproutsTitle'), b: T('sproutsBody'), ex: T('sproutsExample') },
];
---
<Hero
  eyebrow={T('heroEyebrow')}
  title={T('heroTitle')}
  subtitle={T('heroSubtitle')}
  body={T('heroBody')}
  image={images.method.src}
  imageAlt={images.method.alt[lang]}
  imageW={images.method.w}
  imageH={images.method.h}
>
  <CtaGroup
    ctas={[
      { label: T('heroPrimary'),   href: link('/quests/Q001'), variant: 'primary' },
      { label: T('heroSecondary'), href: link('/support'),     variant: 'secondary' },
    ]}
  />
</Hero>

<!-- Core objects -->
<section class="section">
  <div class="container">
    <h2 class="section-title">{T('objTitle')}</h2>
    <p class="section-intro">{T('objIntro')}</p>
    <div class="card-grid cols-3">
      {objects.map((o) => (
        <div class="card">
          <h3 class="card-title">{o.t}</h3>
          <p class="card-body">{o.b}</p>
          <p class="card-example">{o.ex}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Privacy and visibility -->
<section class="section band-soft">
  <div class="container">
    <h2 class="section-title">{T('privTitle')}</h2>
    <p class="section-intro">{T('privBody')}</p>
    <div class="callout" style="max-width: var(--measure);">
      <ul class="callout-list stack-4">
        {methodVisibilityStates.map((s) => (
          <li><strong>{s.k[lang]}</strong> — {s.v[lang]}</li>
        ))}
      </ul>
    </div>
    <p class="prose" style="margin-top: var(--space-6); font-family: var(--font-display); font-size: var(--text-lg);">{T('privTrust')}</p>
  </div>
</section>

<!-- Lineage -->
<section id="lineage" class="section">
  <div class="container">
    <h2 class="section-title">{T('linTitle')}</h2>
    <div class="prose stack-4">
      <p>{T('linBody')}</p>
      <p>{T('linFollowup')}</p>
    </div>
  </div>
</section>

<!-- AI use -->
<section class="section band-soft">
  <div class="container">
    <h2 class="section-title">{T('aiTitle')}</h2>
    <div class="prose stack-4">
      <p>{T('aiBody')}</p>
    </div>
    <p class="prose" style="margin-top: var(--space-5); font-family: var(--font-display); font-size: var(--text-lg);">{T('aiTrust')}</p>
  </div>
</section>

<!-- Acknowledgments -->
<section class="section">
  <div class="container">
    <h2 class="section-title">{T('ackTitle')}</h2>
    <p class="prose">{T('ackBody')}</p>
  </div>
</section>

<!-- Closing CTA -->
<section class="section">
  <div class="container">
    <div class="closing prose">
      <h2 class="section-title">{T('closeTitle')}</h2>
      <p>{T('closeBody')}</p>
      <CtaGroup
        ctas={[
          { label: T('closePrimary'),   href: link('/quests/Q001'), variant: 'primary' },
          { label: T('closeSecondary'), href: link('/support'),     variant: 'secondary' },
        ]}
      />
    </div>
  </div>
</section>
<!-- apps/site/src/components/pages/Method.astro -->
