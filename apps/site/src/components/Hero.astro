---
// apps/site/src/components/Hero.astro
// Editorial hero. Two columns with media when an image is provided; single
// centered-left column when not (used by About). CTAs + microlink come via slot.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  body?: string;
  image?: ImageMetadata;   // imported from src/assets; Astro serves resized AVIF/WebP
  imageAlt?: string;
  imageW?: number;
  imageH?: number;
}
const { eyebrow, title, subtitle, body, image, imageAlt = '', imageW, imageH } = Astro.props;
const hasMedia = Boolean(image);
---
<section class="section hero">
  <div class="container">
    <div class:list={['hero-grid', { 'no-media': !hasMedia }]}>
      <div class="hero-copy">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 class="hero-title">{title}</h1>
        {subtitle && <p class="hero-subtitle">{subtitle}</p>}
        {body && <p class="hero-body">{body}</p>}
        <slot />
      </div>
      {hasMedia && (
        <div class="hero-media">
          <div class="media-frame">
            <Picture
              src={image!}
              alt={imageAlt}
              width={imageW}
              height={imageH}
              widths={[480, 720, 1040, 1400]}
              sizes="(min-width: 860px) 520px, calc(100vw - 2.5rem)"
              formats={['avif']}
              fallbackFormat="webp"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      )}
    </div>
  </div>
</section>
<!-- apps/site/src/components/Hero.astro -->
