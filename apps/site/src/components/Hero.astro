---
// apps/site/src/components/Hero.astro
// Editorial hero. Two columns with media when an image is provided; single
// centered-left column when not (used by About). CTAs + microlink come via slot.
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  body?: string;
  imageSrc?: string;   // already base-prefixed
  imageAlt?: string;
  imageW?: number;
  imageH?: number;
}
const { eyebrow, title, subtitle, body, imageSrc, imageAlt, imageW = 1774, imageH = 887 } = Astro.props;
const hasMedia = Boolean(imageSrc);
---
<section class="section hero">
  <div class="container">
    <div class:list={['hero-grid', { 'no-media': !hasMedia }]}>
      <div class="hero-copy">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 class="hero-title">{title}</h1>
        {subtitle && <p class="hero-subtitle">{subtitle}</p>}
        {body && <p class="hero-body">{body}</p>}
        <slot />
      </div>
      {hasMedia && (
        <div class="hero-media">
          <div class="media-frame">
            <img src={imageSrc} alt={imageAlt} width={imageW} height={imageH} loading="eager" />
          </div>
        </div>
      )}
    </div>
  </div>
</section>
<!-- apps/site/src/components/Hero.astro -->
