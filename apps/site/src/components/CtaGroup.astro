---
// apps/site/src/components/CtaGroup.astro
// A row of call-to-action buttons. External links get target/rel; internal ones don't.
interface Cta {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary';
  external?: boolean;
}
interface Props { ctas: Cta[]; class?: string; }
const { ctas, class: className } = Astro.props;
---
<div class:list={['cta-group', className]}>
  {ctas.map((c) => (
    <a
      href={c.href}
      class:list={['btn', c.variant === 'secondary' ? 'btn-secondary' : 'btn-primary']}
      {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
    >{c.label}</a>
  ))}
</div>
<!-- apps/site/src/components/CtaGroup.astro -->
